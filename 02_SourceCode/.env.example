# YouCam API Configuration (Perfect Corp Developer Portal)
# Obtain your API key from https://yce.perfectcorp.com/api-console/
YOUCAM_API_KEY=your_youcam_api_bearer_token_here
YOUCAM_API_BASE_URL=https://yce.perfectcorp.com/api/v1

# PG-MOD-18 3DGS Engine Configuration
SPATIAL_GAUSSIAN_SPLATS_COUNT=4096
SPATIAL_TARGET_SSIM=0.965

# ASIL-D Functional Safety Boundaries
VRAM_ESTOP_THRESHOLD_GB=50.0
FTTI_ESTOP_TIMEOUT_MS=50.0

# Zero-Data-Residue (ZDR) Privacy Protocol
ZDR_PURGE_PASSES=2
ZDR_ENFORCE_ZERO_FOOTPRINT=true
